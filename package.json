{
  "name": "dsh-workbench-shell",
  "version": "1.11.4",
  "description": "Independent compact navigation and conversation sidebar for official DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "CHANGELOG.md",
    "screenshots.json",
    "media/*.jpg",
    "media/SOURCES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/client.mjs && node --check src/index.mjs && node --check src/chat-model-catalog.mjs",
    "test": "node --test test/navigation.test.mjs test/chat-model-catalog.test.mjs",
    "test:client": "node scripts/test-client.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucky01222/dsh-workbench-shell.git"
  },
  "homepage": "https://github.com/lucky01222/dsh-workbench-shell#readme",
  "bugs": {
    "url": "https://github.com/lucky01222/dsh-workbench-shell/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "navigation"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "0.1.7-rc.2 || 0.2.0-rc.2"
  }
}
